# Copy to .env and fill in. .env is git-ignored — never commit real IDs.
# After editing, run:  npm run check:config  &&  npm run package

# ── Point B — Microsoft / Outlook ────────────────────────────────────────────
# From your Azure AD app registration (README §1). This is the Application
# (client) ID — a GUID. Uses PKCE; there is no Microsoft client secret.
VITE_MS_CLIENT_ID=
VITE_MS_TENANT=common

# ── Point C — Google / Gmail ─────────────────────────────────────────────────
# NOTE: Google's client ID does NOT go here. It goes in manifest.json under
# "oauth2.client_id" because sign-in uses chrome.identity.getAuthToken, which
# reads it from the manifest (README §1b). There is no Google secret either.
